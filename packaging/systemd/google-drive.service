[Unit]
Description=Google Drive para Linux (Ubuntu) Daemon
After=network-online.target graphical-session.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=-/usr/bin/python3 -c "import sys; sys.path.insert(0, '/opt/google-drive-linux'); from core.config import get_mount_point, DEFAULT_MOUNT_POINT, unmount_fuse_path; unmount_fuse_path(get_mount_point()); unmount_fuse_path(DEFAULT_MOUNT_POINT)"
ExecStart=/opt/google-drive-linux/main.py --daemon
ExecStopPost=-/usr/bin/python3 -c "import sys; sys.path.insert(0, '/opt/google-drive-linux'); from core.config import get_mount_point, DEFAULT_MOUNT_POINT, unmount_fuse_path; unmount_fuse_path(get_mount_point()); unmount_fuse_path(DEFAULT_MOUNT_POINT)"
Restart=on-failure
RestartSec=5s
Environment=PYTHONUNBUFFERED=1
PassEnvironment=DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS

[Install]
WantedBy=default.target
