#!/bin/bash
set -e

# Make executables
chmod +x /opt/google-drive-linux/main.py
chmod +x /opt/google-drive-linux/gdrive-cli
chmod +x /opt/google-drive-linux/gdrive-doc-launcher
ln -sf /opt/google-drive-linux/gdrive-cli /usr/local/bin/gdrive-cli
ln -sf /opt/google-drive-linux/gdrive-doc-launcher /usr/local/bin/gdrive-doc-launcher

# Install Nautilus Extension
mkdir -p /usr/share/nautilus-python/extensions/
cp /opt/google-drive-linux/nautilus/google_drive_nautilus.py /usr/share/nautilus-python/extensions/

# Install Desktop file & High-res Icons
cp /opt/google-drive-linux/packaging/desktop/google-drive.desktop /usr/share/applications/
mkdir -p /usr/share/icons/hicolor/256x256/apps/
cp /opt/google-drive-linux/assets/icons/drive_fs.png /usr/share/icons/hicolor/256x256/apps/google-drive.png
cp /opt/google-drive-linux/assets/icons/docs.png /usr/share/icons/hicolor/256x256/apps/google-docs.png
cp /opt/google-drive-linux/assets/icons/sheets.png /usr/share/icons/hicolor/256x256/apps/google-sheets.png
cp /opt/google-drive-linux/assets/icons/slides.png /usr/share/icons/hicolor/256x256/apps/google-slides.png
gtk-update-icon-cache /usr/share/icons/hicolor || true

# Restart Nautilus if running
nautilus -q || true

echo "Google Drive para Linux instalado com sucesso!"
echo "Execute 'gdrive-cli login' para conectar sua conta."
exit 0
