#!/usr/bin/env python3
"""
Google Drive for Linux - Standalone App Window Launcher CLI
Supports:
  gdrive-doc-launcher [doc|sheet|slide]
  gdrive-doc-launcher --type=doc|sheet|slide [ARQUIVO.gdoc|.gsheet|.gslides|ID_OU_URL]
  gdrive-doc-launcher <ARQUIVO_OU_ID_OU_URL> [doc|sheet|slide|form]
"""
import sys
import os

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from core.doc_launcher import launch_doc_as_app

if __name__ == "__main__":
    if len(sys.argv) < 2:
        launch_doc_as_app("doc", "doc")
        sys.exit(0)

    arg1 = sys.argv[1]
    if arg1.startswith("--type="):
        doc_type = arg1.split("=", 1)[1]
        target = sys.argv[2] if len(sys.argv) > 2 else doc_type
        launch_doc_as_app(target, doc_type)
    else:
        doc_type = sys.argv[2] if len(sys.argv) > 2 else "doc"
        launch_doc_as_app(arg1, doc_type)
